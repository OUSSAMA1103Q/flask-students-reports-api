{
  "info": {
    "name": "Flask Students & Reports API",
    "description": "All endpoints of app.py (students, reports, login, refresh) plus error cases. Run the whole collection in order with the Collection Runner: each request checks its expected status code.\n\nBefore running: start the server with `python app.py`, and check the `username` variable matches the hardcoded user in app.py.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:5000"
    },
    {
      "key": "username",
      "value": "admin"
    },
    {
      "key": "password",
      "value": "test123456"
    },
    {
      "key": "access_token",
      "value": ""
    },
    {
      "key": "refresh_token",
      "value": ""
    },
    {
      "key": "report_id",
      "value": "1"
    },
    {
      "key": "student_id",
      "value": "1"
    },
    {
      "key": "student2_id",
      "value": "2"
    }
  ],
  "item": [
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "Login with wrong password → 401",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "login"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"wrong\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 401\", () => pm.expect([401]).to.include(pm.response.code));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login → 200 (saves tokens)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "login"
              ]
            },
            "description": "Returns an access token (15 min) and a refresh token (7 days). Both are saved automatically into the collection variables.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.expect([200]).to.include(pm.response.code));",
                  "let j; try { j = pm.response.json(); } catch (e) { j = {}; }",
                  "const d = j.data || j;",
                  "const a = d.access_token || d.accessToken || d.token;",
                  "const r = d.refresh_token || d.refreshToken;",
                  "if (a) pm.collectionVariables.set(\"access_token\", a);",
                  "if (r) pm.collectionVariables.set(\"refresh_token\", r);",
                  "pm.test(\"Access token received\", () => pm.expect(a).to.be.a(\"string\"));"
                ]
              }
            }
          ]
        }
      ]
    },
