    {
      "name": "5. Tokens & errors",
      "item": [
        {
          "name": "Refresh → 200 (new access token)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/refresh",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "refresh"
              ]
            },
            "description": "Sends the refresh token in the JSON body and gets a new access token (saved automatically).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refresh_token}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.expect([200]).to.include(pm.response.code));",
                  "let j; try { j = pm.response.json(); } catch (e) { j = {}; }",
                  "const d = j.data || j;",
                  "const a = d.access_token || d.accessToken || d.token;",
                  "const r = d.refresh_token || d.refreshToken;",
                  "if (a) pm.collectionVariables.set(\"access_token\", a);",
                  "if (r) pm.collectionVariables.set(\"refresh_token\", r);",
                  "pm.test(\"Access token received\", () => pm.expect(a).to.be.a(\"string\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh using the ACCESS token → 401",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/refresh",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "refresh"
              ]
            },
            "description": "The token's \"type\" field is 'access', so /refresh refuses it.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{access_token}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 401\", () => pm.expect([401]).to.include(pm.response.code));"
                ]
              }
            }
          ]
        },
        {
          "name": "Use REFRESH token on GET /students → 401",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/students",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "students"
              ]
            },
            "description": "",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{refresh_token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
